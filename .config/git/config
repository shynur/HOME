[user]
        name = 谢骐
        email = shynur@outlook.com
[core]
        editor = emacsclient -alternate-editor= -create-frame -quiet --
[transfer]
        #fsckObjects = true
[color]
        ui = auto
[init]
        defaultBranch = trunk
[alias]
        log- = log --graph --abbrev-commit
        merge- = merge --no-ff
        remote- = remote --verbose
[credential]
        helper = store
[push]
        default = current
        autoSetupRemote = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true
	clean = git-lfs clean -- %f
